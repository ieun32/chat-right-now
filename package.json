{
  "name": "chat-right-now",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop pet mesh chat - pixel animals roaming your Windows desktop with real-time P2P chat",
  "main": "src/main/main.js",
  "scripts": {
    "gen:sprites": "node tools/gen-sprites.mjs",
    "build": "node tools/build.mjs",
    "watch": "node tools/build.mjs --watch",
    "start": "npm run build && electron .",
    "dev": "node tools/dev.mjs",
    "signal": "node tools/dev-signal-server.mjs",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "electron": "^33.0.0",
    "ws": "^8.18.0"
  },
  "build": {
    "appId": "com.chatrightnow.app",
    "productName": "ChatRightNow",
    "files": ["src/main/**", "dist/**", "assets/**", "config.json"],
    "win": { "target": "nsis" }
  }
}
