{
  "name": "chat-right-now",
  "version": "0.2.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "Desktop pet mesh chat - pixel animals roaming your Windows desktop with real-time P2P chat",
  "main": "src/main/main.js",
  "scripts": {
    "gen:sprites": "node tools/gen-sprites.mjs",
    "build": "node tools/build.mjs",
    "watch": "node tools/build.mjs --watch",
    "start": "npm run build && electron .",
    "dev": "node tools/dev.mjs",
    "signal": "node tools/dev-signal-server.mjs",
    "dist": "node tools/build.mjs --release && electron-builder --win --publish never",
    "test": "node --test tests/*.test.mjs tests/*.test.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "electron-updater": "6.8.9",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "ws": "^8.18.0"
  },
  "build": {
    "appId": "com.chatrightnow.app",
    "productName": "ChatRightNow",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/main/**",
      "dist/index.html",
      "dist/renderer.js",
      "dist/styles.css",
      "dist/config.json",
      "assets/**",
      "LICENSE"
    ],
    "publish": [{ "provider": "github", "owner": "ieun32", "repo": "chat-right-now", "releaseType": "release" }],
    "artifactName": "ChatRightNow-Setup-${version}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ChatRightNow"
    }
  }
}
